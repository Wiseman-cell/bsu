generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AcademicLevel {
  CERTIFICATE
  DIPLOMA
  UNDERGRADUATE
  POSTGRADUATE
  DOCTORATE
}

enum CampusLocation {
  THIKA_MAIN
  COUNTY_HUB
  KIGALI_RWANDA
  LILONGWE_MALAWI
  MOGADISHU_SOMALIA
}

model School {
  id          String       @id @default(uuid())
  name        String       @unique
  code        String       @unique
  slug        String       @unique
  description String?      @db.Text
  departments Department[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Department {
  id          String      @id @default(uuid())
  name        String
  code        String      @unique
  schoolId    String
  school      School      @relation(fields: [schoolId], references: [id])
  programmes  Programme[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Programme {
  id              String        @id @default(uuid())
  title           String
  slug            String        @unique
  code            String        @unique
  level           AcademicLevel
  isFlagship      Boolean       @default(false)
  durationYears   Float
  departmentId    String
  department      Department    @relation(fields: [departmentId], references: [id])
  requirements    String        @db.Text
  feeStructurePdf String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model GlobalHealthOutreach {
  id           String         @id @default(uuid())
  title        String
  campaignYear Int            @default(2026)
  location     CampusLocation
  startDate    DateTime
  endDate      DateTime
  targetCases  Int
  description  String         @db.Text
  createdAt    DateTime       @default(now())
}

model Tender {
  id             String   @id @default(uuid())
  refNumber      String   @unique
  title          String
  category       String
  pdfDocumentUrl String
  closingDate    DateTime
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
}

// ─── Content Management ───

model NewsArticle {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  excerpt     String   @db.Text
  content     String   @db.Text
  category    String
  publishedAt DateTime @default(now())
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Event {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  description String   @db.Text
  location    String
  startDate   DateTime
  endDate     DateTime?
  category    String
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Notice {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  content     String   @db.Text
  category    String
  isUrgent    Boolean  @default(false)
  expiresAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Download {
  id          String   @id @default(uuid())
  title       String
  description String?  @db.Text
  category    String
  fileUrl     String
  fileSize    String?
  createdAt   DateTime @default(now())
}

model GalleryImage {
  id          String   @id @default(uuid())
  title       String
  description String?  @db.Text
  imageUrl    String
  category    String
  createdAt   DateTime @default(now())
}

// ─── Form Submissions ───

model VolunteerRegistration {
  id                String   @id @default(uuid())
  fullName          String
  email             String
  phone             String
  idNumber          String
  location          CampusLocation
  role              String
  availabilityStart DateTime
  availabilityEnd   DateTime
  priorExperience   String?  @db.Text
  emergencyContact  String
  createdAt         DateTime @default(now())
}

model TenderSubmission {
  id              String   @id @default(uuid())
  refNumber       String
  companyName     String
  contactEmail    String
  contactPhone    String
  proposalSummary String   @db.Text
  submissionType  String
  status          String   @default("under_review")
  receivedAt      DateTime @default(now())
}

// ─── Authentication ───

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String
  role          UserRole  @default(STUDENT)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  studentProfile StudentProfile?
  staffProfile   StaffProfile?
}

enum UserRole {
  STUDENT
  STAFF
  ADMIN
}

model StudentProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  admissionNumber String   @unique
  fullName        String
  school          String
  programme       String
  yearOfStudy     Int
  semester        String
  academicYear    String
  status          String   @default("Active")
  gpa             String?
  unitsRegistered Int      @default(0)
  feeBalance      Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model StaffProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  staffId   String   @unique
  fullName  String
  department String
  position  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
